ARG BASE_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.0-dev2
FROM ${BASE_IMAGE}

USER root

ARG ARENA_REPO=https://github.com/rebeccazhang0707/IsaacLab-Arena.git
ARG ARENA_COMMIT=40ad41612dc89cb0d4ae74112175da2bf1074282
ARG FLASH_ATTN_WHEEL_URL=https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.7.16/flash_attn-2.7.4%2Bcu128torch2.10-cp312-cp312-linux_x86_64.whl
ARG DEBIAN_FRONTEND=noninteractive

ENV PIP_NO_CACHE_DIR=1 \
    ARENA_ROOT=/workspace/arena \
    ISAACLAB_PATH=/workspace/arena/submodules/IsaacLab \
    LW_API_ENDPOINT=https://api.lightwheel.net \
    PATH=/isaac-sim/kit/python/bin:${PATH} \
    PYTHONPATH=/workspace/arena:/workspace/arena/submodules/Isaac-GR00T:/workspace/project/src

RUN if [ -e /usr/share/vulkan ] && [ -e /etc/vulkan ]; then \
      mv /usr/share/vulkan /usr/share/vulkan_hidden; \
    fi

RUN env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
      apt-get update \
    && env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY \
      apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      ffmpeg \
      git \
      git-lfs \
    && rm -rf /var/lib/apt/lists/*

# Arena owns the verified IsaacLab and GR00T revisions. Their optional nested
# benchmark repositories are not runtime dependencies of Arena eval or ReCap.
RUN git clone --filter=blob:none "${ARENA_REPO}" "${ARENA_ROOT}" \
    && cd "${ARENA_ROOT}" \
    && git checkout "${ARENA_COMMIT}" \
    && git config -f .gitmodules submodule.submodules/Isaac-GR00T.url https://github.com/NVIDIA/Isaac-GR00T.git \
    && git config -f .gitmodules submodule.submodules/IsaacLab.url https://github.com/isaac-sim/IsaacLab.git \
    && git submodule sync -- submodules/Isaac-GR00T submodules/IsaacLab \
    && git submodule update --init -- submodules/Isaac-GR00T submodules/IsaacLab \
    && rm -rf .git submodules/Isaac-GR00T/.git submodules/IsaacLab/.git

RUN ln -s /isaac-sim "${ISAACLAB_PATH}/_isaac_sim" \
    && "${ISAACLAB_PATH}/isaaclab.sh" -i 'assets,physx,tasks,ov,rl[rsl_rl]' \
    && /isaac-sim/python.sh -m pip install --no-deps -e "${ISAACLAB_PATH}/source/isaaclab_teleop" \
    && /isaac-sim/python.sh -m pip install --no-deps -e "${ISAACLAB_PATH}/source/isaaclab_visualizers" \
    && /isaac-sim/python.sh -m pip install isaacteleop~=1.1.0 --extra-index-url https://pypi.nvidia.com

RUN /isaac-sim/python.sh -m pip install -e "${ARENA_ROOT}"

# Isaac Sim supplies Torch 2.10, CUDA 12.8 runtime libraries, and NumPy 2.
# Install only the compatible prebuilt FlashAttention wheel; a second CUDA
# toolkit or Torch stack would add size and can make distributed loading fail.
# The pinned GR00T metadata excludes Isaac's Python 3.12 even though this exact
# combination passes eval and training, so bypass only that version declaration.
RUN /isaac-sim/python.sh -m pip install "${FLASH_ATTN_WHEEL_URL}" \
    && /isaac-sim/python.sh -m pip install --no-deps --ignore-requires-python \
      -e "${ARENA_ROOT}/submodules/Isaac-GR00T" \
    && /isaac-sim/python.sh -m pip install --no-deps \
      lerobot==0.4.4 \
      verl==0.7.1

# LeRobot and verl publish Torch/NumPy constraints for standalone environments
# that conflict with Isaac Sim. Their verified runtime dependencies are installed
# explicitly while preserving the base image's Torch and NumPy.
RUN printf 'torch==%s\nnumpy==%s\n' \
      "$(/isaac-sim/python.sh -c 'import torch; print(torch.__version__)')" \
      "$(/isaac-sim/python.sh -c 'import numpy; print(numpy.__version__)')" \
      > /tmp/isaac_constraints.txt \
    && /isaac-sim/python.sh -m pip install \
      --constraint /tmp/isaac_constraints.txt \
      accelerate==1.2.1 \
      albumentations==1.4.18 \
      av==15.0.0 \
      click==8.1.8 \
      codetiming \
      datasets==4.0.0 \
      decord==0.6.0 \
      deepdiff==8.6.2 \
      diffusers==0.35.1 \
      dill \
      dm-tree==0.1.8 \
      draccus==0.10.0 \
      einops==0.8.1 \
      fastapi \
      feetech-servo-sdk==1.0.0 \
      hjson==3.1.0 \
      'huggingface-hub[cli]==0.35.3' \
      hydra-core \
      'imageio[ffmpeg]==2.37.3' \
      jsonlines==4.0.0 \
      kornia==0.7.4 \
      lmdb==1.7.5 \
      matplotlib==3.10.1 \
      msgpack==1.1.0 \
      msgpack-numpy==0.4.8 \
      ninja==1.13.0 \
      omegaconf==2.3.0 \
      onnx-ir \
      pandas==2.2.3 \
      peft==0.17.0 \
      py-cpuinfo==9.0.0 \
      pyarrow==19.0.1 \
      pybind11 \
      pylatexenc \
      pynput==1.8.2 \
      pyserial==3.5 \
      pyzmq==27.0.1 \
      ray==2.47.0 \
      scipy \
      tensordict==0.10.0 \
      termcolor==3.2.0 \
      timm==1.0.14 \
      tokenizers==0.21.4 \
      torchcodec==0.10.0 \
      torchdata \
      tqdm==4.67.1 \
      transformers==4.51.3 \
      tyro \
      'uvicorn[standard]' \
      wandb==0.23.0 \
    && rm -f /tmp/isaac_constraints.txt

# Point Ray's generated CLI at Isaac's Python wrapper so interactive `ray start`
# sees the same prebundled modules as training workers.
RUN sed -i '1c#!/isaac-sim/python.sh' /isaac-sim/kit/python/bin/ray

RUN mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '{\n  "file_format_version":"1.0.0",\n  "ICD":{"library_path":"libEGL_nvidia.so.0"}\n}\n' \
       > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

ENV NVIDIA_DRIVER_CAPABILITIES=all \
    VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json \
    PYOPENGL_PLATFORM=egl \
    __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json

WORKDIR /workspace/project
RUN mkdir -p /workspace/project/.data/gr00t_arena/cache/root_cache/{nv,triton/autotune} \
    && rm -rf /root/.cache /root/.nv /root/.triton \
    && ln -s /workspace/project/.data/gr00t_arena/cache/root_cache /root/.cache \
    && ln -s /workspace/project/.data/gr00t_arena/cache/root_cache/nv /root/.nv \
    && ln -s /workspace/project/.data/gr00t_arena/cache/root_cache/triton /root/.triton

COPY . /workspace/project
RUN /isaac-sim/python.sh -m pip install --no-build-isolation --no-deps -e /workspace/project

ENTRYPOINT []
CMD ["/bin/bash"]
